# Copy to .env and fill in. python-decouple reads this file (anchored to the project
# root in organizer/settings.py). Real OS environment variables take precedence, so
# production / CI can inject these instead of using a file.

# --- Django core ---
# Generate a fresh one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production
DEBUG=True
# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL only) ---
DB_NAME=organizer
DB_USER=organizer
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Test database (optional; managed by bin/wt in worktrees) ---
# Explicit test DB name; defaults to test_<DB_NAME>. Leave unset on the main
# checkout — bin/wt sets a unique per-worktree value automatically.
# DB_TEST_NAME=test_organizer
# A prebuilt Postgres template DB to clone the test DB from (fast cold builds).
# Leave unset unless it exists — build it with `bin/wt template refresh`.
# TEST_DB_TEMPLATE=organizer_test_template

# --- Frontend / CORS ---
# Comma-separated origins allowed to call the API (the Angular dev server, prod UI host, …).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Time ---
# The timezone the day boundary is drawn in: the Today view, the stats periods, and recurring-task
# generation all work in whole local days. Set it to where you actually are — running in UTC skews
# every "today" by the UTC offset. Datetimes are still stored in UTC (USE_TZ).
TIME_ZONE=Europe/Bucharest

# --- Celery (recurring-task scheduling) ---
# Redis broker for celery beat/worker. Only needed for automatic recurring-task generation;
# the REST API works without it, and `manage.py generate_recurring_tasks` is a manual fallback.
CELERY_BROKER_URL=redis://localhost:6379/0
# Optional result backend (leave blank if you don't need task results).
CELERY_RESULT_BACKEND=
# Hour of day (0–23, local TIME_ZONE) the beat job runs to generate due tasks.
RECURRING_TASKS_HOUR=6

# --- Channels (real-time task sync over WebSockets) ---
# Redis channel layer backing the /ws/tasks/ endpoint, which pushes live task updates to a user's
# open browsers/phone. Reuses the same Redis as Celery but a SEPARATE DB index (/1, not /0) so the
# two never collide. Optional infrastructure: if it's unreachable, live updates pause and the app
# falls back to manual refresh — nothing else breaks.
CHANNELS_REDIS_URL=redis://localhost:6379/1

# --- MCP server + OAuth 2.1 authorization server ---
# Public, externally-reachable base URL of this deployment. Anchors the OAuth issuer and the
# MCP resource identifier in discovery metadata, so it MUST match the URL the MCP client
# connects to (e.g. https://organizer.example.com). Serve the MCP endpoint under ASGI:
#   uv run uvicorn organizer.asgi:application
MCP_BASE_URL=http://localhost:8000
# OAuth access/refresh token lifetimes, in seconds (defaults: 8h / 30d).
OAUTH_ACCESS_TOKEN_TTL=28800
OAUTH_REFRESH_TOKEN_TTL=2592000

# --- Third-party integrations -----------------------------------------------------------
# Fernet key encrypting per-user OAuth credentials stored by integrations/. Shared by every
# provider. If unset, a key is derived from SECRET_KEY (fine for dev; in production that means
# rotating SECRET_KEY strands every stored token). Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATIONS_TOKEN_KEY=
# Absolute URL of the Angular SPA. OAuth callbacks are plain browser navigations and bounce the
# user back here when the flow finishes.
FRONTEND_BASE_URL=http://localhost:4200

# --- Notion sync ------------------------------------------------------------------------
# From the public integration you register once at https://www.notion.so/my-integrations.
# Notion has no dynamic client registration; the redirect URI below must be registered there
# *exactly* as written. Leave the id/secret blank to disable Notion sync.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/integrations/notion/callback/
# Pinned API version: 2025-09-03 introduced data sources, which the sync addresses directly.
NOTION_API_VERSION=2025-09-03
# Incremental sync cadence, and how often a run escalates to a full reconciliation.
NOTION_SYNC_MINUTES=10
NOTION_FULL_SYNC_HOURS=24
