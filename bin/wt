#!/usr/bin/env bash
# wt — manage organizer git worktrees with their own DB, venv, env, and .claude settings.
#
#   wt new  <branch> [path]     create worktree (DB seeded from main, .venv via uv sync)
#   wt rm   <path> [--force]    drop the DB, remove the worktree (in-tree .venv goes with it)
#   wt sync [path]              rebase the worktree branch onto fresh origin/develop
#                               and check the migration graph is single-leaf
#   wt prune [--force]          drop Postgres DBs orphaned by removed worktrees
#                               (dry-run unless --force)
#   wt template <refresh|check> rebuild (or check) the shared `<main_db>_test_template`
#                               Postgres DB so cold test-DB builds clone instead of
#                               replaying migrations. Refresh after develop moves.
#   wt ls                       list worktrees
#
# Defaults the worktree path to .claude/worktrees/<slug>. The slug is derived from
# the branch name (lowercased, non-alnum → underscore) and names the per-worktree
# Postgres DB (<main_db>_<slug>). The Python env is a uv-managed .venv inside the
# worktree (deps hardlinked from uv's shared cache, so each worktree adds almost no
# disk), removed with the worktree and never orphaned.
#
# New branches are based on fresh origin/develop. Override the base branch with
# WT_BASE_BRANCH=<branch> (falls back to a local branch when there is no remote one).
set -euo pipefail

# Resolve to the *main* repo even when this script is invoked from a copy inside a
# linked worktree (every worktree has its own bin/wt). `--show-toplevel` would return
# the worktree's path; `--git-common-dir` returns the shared .git dir, whose parent is
# the main worktree.
PROJECT_ROOT="$(dirname "$(git -C "$(dirname "$(readlink -f "$0")")/.." rev-parse --path-format=absolute --git-common-dir)")"
BASE_BRANCH="${WT_BASE_BRANCH:-develop}"

err() { echo "wt: $*" >&2; exit 1; }
log() { echo "→ $*"; }

# Resolve uv into $UV. Under WSL the Windows install can leak onto PATH via interop;
# never trust anything under /mnt/, prefer the Linux ~/.local/bin/uv.
UV=""
ensure_uv() {
  [[ -n "$UV" ]] && return 0
  local candidate
  for candidate in "$HOME/.local/bin/uv" /usr/local/bin/uv /usr/bin/uv; do
    [[ -x "$candidate" && "$candidate" != /mnt/* ]] && { UV="$candidate"; break; }
  done
  [[ -z "$UV" ]] && UV="$(command -v uv 2>/dev/null || true)"
  [[ -n "$UV" && "$UV" != /mnt/* ]] || err "uv not found — install with: curl -LsSf https://astral.sh/uv/install.sh | sh"
  log "uv: $UV ($("$UV" --version))"
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '_' | sed -E 's/_+/_/g; s/^_+|_+$//g'
}

read_env_var() {
  local var="$1" file="$2"
  [[ -f "$file" ]] || return 0
  grep -E "^${var}=" "$file" | tail -n1 | cut -d= -f2- | sed -E 's/^["'"'"']//;s/["'"'"']$//'
}

# Fetch and resolve the ref new worktrees branch off. Prefers origin/<BASE_BRANCH>
# (a routinely-stale local <BASE_BRANCH> would force a rebase later and invite
# migration leaf collisions); falls back to a local branch when there is no remote.
resolve_base_ref() {
  git -C "$PROJECT_ROOT" fetch --quiet origin "$BASE_BRANCH" 2>/dev/null || true
  if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/remotes/origin/${BASE_BRANCH}"; then
    echo "origin/${BASE_BRANCH}"
  elif git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/${BASE_BRANCH}"; then
    echo "$BASE_BRANCH"
  else
    err "base branch not found: origin/${BASE_BRANCH} or ${BASE_BRANCH}"
  fi
}

# The shared Postgres template DB used as the source of `CREATE DATABASE … WITH
# TEMPLATE …` for cold test-DB builds. See `cmd_template` and settings.py's
# TEST_DB_TEMPLATE plumbing. Named after the main DB so it lives alongside it.
template_db_name() {
  local main_db; main_db="$(read_env_var DB_NAME "${PROJECT_ROOT}/.env")"
  echo "${main_db}_test_template"
}

# True iff the template DB exists in the cluster. Returns 0/1 only — no stdout — so
# it composes cleanly in `if template_db_exists; then …`.
template_db_exists() {
  local main_env="${PROJECT_ROOT}/.env"
  local main_user main_pw main_port main_host tmpl
  main_user="$(read_env_var DB_USER     "$main_env")"
  main_pw="$(read_env_var   DB_PASSWORD "$main_env")"
  main_port="$(read_env_var DB_PORT     "$main_env")"
  main_host="$(read_env_var DB_HOST     "$main_env")"; main_host="${main_host:-127.0.0.1}"
  tmpl="$(template_db_name)"
  command -v psql >/dev/null || return 1
  PGPASSWORD="$main_pw" psql -h "$main_host" -p "$main_port" -U "$main_user" \
    -d postgres -tAc \
    "SELECT 1 FROM pg_database WHERE datname='${tmpl}'" 2>/dev/null \
    | grep -q '^1$'
}

# Write a worktree .envrc that activates the in-tree uv .venv and loads .env.
# organizer's main .envrc is a pyenv-based symlink into a private settings dir;
# worktrees deliberately use their own in-tree uv .venv instead, so we generate a
# fresh, self-contained .envrc rather than copying that one.
write_envrc() {
  local target="$1"
  cat > "${target}/.envrc" <<'ENVRC'
# Auto-generated by bin/wt for this worktree. Activates the in-tree uv .venv and
# loads .env. `export VIRTUAL_ENV="$PWD/.venv"` is identical across worktrees
# (each has its own .venv), so this needs no per-worktree patching.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$PWD/.venv/bin"
dotenv
ENVRC
}

cmd_new() {
  local branch="${1:-}" target="${2:-}"
  [[ -n "$branch" ]] || err "usage: wt new <branch> [path]"
  ensure_uv
  command -v pg_dump >/dev/null || err "pg_dump not on PATH"

  local slug; slug="$(slugify "$branch")"
  target="${target:-${PROJECT_ROOT}/.claude/worktrees/${slug}}"
  [[ -e "$target" ]] && err "target exists: $target"

  local main_env="${PROJECT_ROOT}/.env"
  [[ -f "$main_env" ]] || err "missing $main_env"
  local main_db main_user main_pw main_port main_host
  main_db="$(read_env_var DB_NAME "$main_env")"
  main_user="$(read_env_var DB_USER "$main_env")"
  main_pw="$(read_env_var DB_PASSWORD "$main_env")"
  main_port="$(read_env_var DB_PORT "$main_env")"
  main_host="$(read_env_var DB_HOST "$main_env")"; main_host="${main_host:-127.0.0.1}"
  [[ -n "$main_db" ]] || err "DB_NAME not set in $main_env"

  local new_db="${main_db}_${slug}"

  local base_ref; base_ref="$(resolve_base_ref)"
  log "git worktree add $target $branch (base: $base_ref)"
  if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$PROJECT_ROOT" worktree add "$target" "$branch"
  else
    git -C "$PROJECT_ROOT" worktree add -b "$branch" "$target" "$base_ref"
  fi

  log "write .env / .envrc and patch DB_NAME + DB_TEST_NAME"
  # .env / .envrc are gitignored (never checked out into the worktree), so create
  # them fresh. Copy the resolved main .env (it's a symlink into a private settings
  # dir; cp dereferences it into a real, per-worktree file).
  cp "$main_env" "${target}/.env"
  write_envrc "$target"
  sed -i -E "s|^DB_NAME=.*|DB_NAME=${new_db}|" "${target}/.env"
  # Pin an explicit per-worktree test DB. settings.py reads DB_TEST_NAME (default
  # test_<DB_NAME>); the main .env never sets it, so only worktrees get an override.
  # organizer anchors python-decouple to BASE_DIR/.env, so each worktree already
  # resolves its own DB_NAME — this just makes the test-DB name explicit and greppable.
  if grep -qE "^DB_TEST_NAME=" "${target}/.env"; then
    sed -i -E "s|^DB_TEST_NAME=.*|DB_TEST_NAME=test_${new_db}|" "${target}/.env"
  else
    printf 'DB_TEST_NAME=test_%s\n' "${new_db}" >> "${target}/.env"
  fi
  # Opt-in to template cloning only when the cluster already has the template DB.
  # Skipping the line on absence is intentional: settings.py passes it through to
  # Django's PG backend, which would raise on a non-existent template name.
  # `bin/wt template refresh` creates it.
  if template_db_exists; then
    local tmpl; tmpl="$(template_db_name)"
    if grep -qE "^TEST_DB_TEMPLATE=" "${target}/.env"; then
      sed -i -E "s|^TEST_DB_TEMPLATE=.*|TEST_DB_TEMPLATE=${tmpl}|" "${target}/.env"
    else
      printf 'TEST_DB_TEMPLATE=%s\n' "${tmpl}" >> "${target}/.env"
    fi
    log "TEST_DB_TEMPLATE=${tmpl} (test DB will clone from template)"
  fi

  local venv_bin="${target}/.venv/bin"
  log "uv sync (.venv from uv.lock, incl. dev group)"
  # Unset VIRTUAL_ENV so uv targets the worktree's own .venv, not whatever env is
  # active in the shell that ran `wt new` (which would otherwise be reused).
  ( cd "$target" && unset VIRTUAL_ENV && "$UV" sync )

  log "createdb ${new_db} and seed from ${main_db}"
  local pg_args=(-h "$main_host" -p "$main_port" -U "$main_user")
  PGPASSWORD="$main_pw" createdb "${pg_args[@]}" "$new_db"
  PGPASSWORD="$main_pw" pg_dump "${pg_args[@]}" --no-owner --no-privileges "$main_db" \
    | PGPASSWORD="$main_pw" psql "${pg_args[@]}" -d "$new_db" --quiet -v ON_ERROR_STOP=1 \
        >/dev/null

  log "manage.py migrate (covers migrations newer than main)"
  ( cd "$target" && "${venv_bin}/python" manage.py migrate --noinput ) \
    || echo "  (migrate failed — re-run inside $target after fixing)"

  # settings.json + commands/ are tracked, so the checkout already has them; only
  # settings.local.json (git-ignored) needs copying so the agent keeps its perms.
  if [[ -f "${PROJECT_ROOT}/.claude/settings.local.json" ]]; then
    log "copy .claude/settings.local.json"
    mkdir -p "${target}/.claude"
    cp "${PROJECT_ROOT}/.claude/settings.local.json" "${target}/.claude/settings.local.json"
  fi

  if command -v direnv >/dev/null; then
    ( cd "$target" && direnv allow ) >/dev/null 2>&1 || true
  fi

  cat <<EOF

✔ worktree ready
  path:   $target
  branch: $branch
  venv:   ${target}/.venv (uv)
  db:     $new_db

  cd $target
EOF
}

cmd_rm() {
  local target="" force=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force="--force" ;;
      -*)      err "unknown flag: $1" ;;
      *)       target="$1" ;;
    esac
    shift
  done
  [[ -n "$target" ]] || err "usage: wt rm <path> [--force]"
  target="$(realpath -m "$target")"
  [[ -d "$target" ]] || err "not found: $target"
  [[ "$(pwd)" == "$target"* ]] && err "refusing: you are inside $target"

  local main_db wt_db
  main_db="$(read_env_var DB_NAME "${PROJECT_ROOT}/.env")"
  wt_db="$(read_env_var DB_NAME "${target}/.env" || true)"

  if [[ -n "$wt_db" && "$wt_db" != "$main_db" ]]; then
    log "drop database $wt_db"
    local user pw port host
    user="$(read_env_var DB_USER     "${target}/.env")"
    pw="$(read_env_var   DB_PASSWORD "${target}/.env")"
    port="$(read_env_var DB_PORT     "${target}/.env")"
    host="$(read_env_var DB_HOST     "${target}/.env")"; host="${host:-127.0.0.1}"
    PGPASSWORD="$pw" dropdb -h "$host" -p "$port" -U "$user" --if-exists --force "$wt_db" || true
  fi

  log "git worktree remove ${force:-} $target"
  # shellcheck disable=SC2086
  git -C "$PROJECT_ROOT" worktree remove ${force} "$target"
}

cmd_sync() {
  # Rebase a worktree's branch onto fresh origin/<BASE_BRANCH> and verify the
  # migration graph is single-leaf. Run right before finalizing a PR (then
  # regenerate migrations, so numbering is correct against current develop — see
  # CLAUDE.md "Migrations + the leaf-collision race").
  local target="${1:-$PWD}"
  target="$(cd "$target" && pwd)"
  [[ -d "$target/.git" || -f "$target/.git" ]] || err "not a worktree: $target"

  local base_ref; base_ref="$(resolve_base_ref)"

  if ! git -C "$target" diff --quiet || ! git -C "$target" diff --cached --quiet; then
    err "working tree not clean — commit/stash before: wt sync"
  fi

  log "rebase $(git -C "$target" rev-parse --abbrev-ref HEAD) onto $base_ref"
  if ! git -C "$target" rebase "$base_ref"; then
    err "rebase hit conflicts — resolve in $target, then 'git rebase --continue'"
  fi

  log "check migration graph (single leaf?)"
  local py="${target}/.venv/bin/python"
  [[ -x "$py" ]] || py="python"
  if (cd "$target" && "$py" manage.py makemigrations --check --dry-run >/dev/null 2>&1); then
    log "OK — branch rebased, migration graph single-leaf."
  else
    log "WARNING — 'makemigrations --check' failed. Likely a leaf collision:"
    (cd "$target" && "$py" manage.py makemigrations --check --dry-run 2>&1 | tail -3) || true
    log "Fix: delete your stale migration, re-run makemigrations so it depends"
    log "on the current leaf, then commit. Avoid 'makemigrations --merge'."
  fi
}

cmd_prune() {
  # Drop per-worktree Postgres DBs that no longer belong to a live worktree.
  # Worktrees torn down without `wt rm` (plain `git worktree remove`, `rm -rf`, a
  # failed `wt rm`) leak their DB; this garbage-collects them. Dry-run by default —
  # pass --force to actually delete. (uv .venv lives in-tree and dies with the
  # worktree, so there is nothing venv-side to orphan.)
  local force=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      -*)      err "unknown flag: $1" ;;
      *)       err "unexpected arg: $1" ;;
    esac
    shift
  done

  local main_env="${PROJECT_ROOT}/.env" main_db main_user main_pw main_port main_host
  main_db="$(read_env_var DB_NAME "$main_env")"
  main_user="$(read_env_var DB_USER "$main_env")"
  main_pw="$(read_env_var DB_PASSWORD "$main_env")"
  main_port="$(read_env_var DB_PORT "$main_env")"
  main_host="$(read_env_var DB_HOST "$main_env")"; main_host="${main_host:-127.0.0.1}"
  [[ -n "$main_db" ]] || err "DB_NAME not set in $main_env"
  command -v psql >/dev/null || err "psql not on PATH"

  local keep_dbs db wtpath unresolved=""
  keep_dbs="$(mktemp)"
  echo "$main_db" >> "$keep_dbs"
  # Never treat the shared test-template DB as an orphan: it matches the <main_db>_*
  # namespace but belongs to no worktree.
  local tmpl_db; tmpl_db="$(template_db_name 2>/dev/null || true)"
  [[ -n "$tmpl_db" ]] && echo "$tmpl_db" >> "$keep_dbs"

  while IFS= read -r wtpath; do
    [[ -n "$wtpath" ]] || continue
    # Path-derived fallback name (mirrors `wt new`'s `${main_db}_<slug>`), so a live
    # worktree is KEPT even if its .env is missing or unreadable.
    echo "${main_db}_$(slugify "$(basename "$wtpath")")" >> "$keep_dbs"
    if [[ -f "${wtpath}/.env" ]]; then
      db="$(read_env_var DB_NAME "${wtpath}/.env" || true)"
      if [[ -n "$db" ]]; then
        echo "$db" >> "$keep_dbs"
      else
        unresolved+=$'\n'"    ${wtpath} (.env present but DB_NAME unreadable)"
      fi
    else
      unresolved+=$'\n'"    ${wtpath} (no .env)"
    fi
  done < <(git -C "$PROJECT_ROOT" worktree list --porcelain | sed -n 's/^worktree //p')
  sort -u -o "$keep_dbs" "$keep_dbs"

  local orphan_dbs=()
  while IFS= read -r db; do
    [[ -z "$db" || "$db" == "$main_db" ]] && continue
    [[ "$db" == "${main_db}_"* ]] || continue
    grep -qxF "$db" "$keep_dbs" || orphan_dbs+=("$db")
  done < <(PGPASSWORD="$main_pw" psql -h "$main_host" -p "$main_port" -U "$main_user" \
             -d postgres -tAc "SELECT datname FROM pg_database WHERE datname LIKE '${main_db}\\_%'" 2>/dev/null | sort -u)
  rm -f "$keep_dbs"

  if [[ ${#orphan_dbs[@]} -eq 0 ]]; then
    log "no orphan databases."
  else
    log "orphan databases (${#orphan_dbs[@]}):"
    printf '    %s\n' "${orphan_dbs[@]}"
    # Fail safe: if any LIVE worktree couldn't be resolved to a DB name, refuse to
    # delete — keeping a real orphan beats dropping a live database.
    if [[ -n "$unresolved" && -n "$force" ]]; then
      log "REFUSING to drop databases: these live worktrees have no resolvable DB name:${unresolved}"
      log "Fix their .env (DB_NAME=…) or remove them with 'bin/wt rm', then re-run prune."
    elif [[ -n "$force" ]]; then
      for db in "${orphan_dbs[@]}"; do
        log "drop database $db"
        PGPASSWORD="$main_pw" dropdb -h "$main_host" -p "$main_port" -U "$main_user" \
          --if-exists --force "$db" || log "  (failed to drop $db)"
      done
    fi
  fi

  if [[ -z "$force" ]]; then
    echo
    log "dry-run — re-run 'wt prune --force' to delete the orphans listed above."
  fi
}

cmd_template() {
  # Maintain the shared `<main_db>_test_template` Postgres DB used as the `WITH
  # TEMPLATE …` source for cold test-DB builds. The first `manage.py test` after
  # `bin/wt new` then clones in seconds instead of replaying every migration.
  # Refresh after pulling develop with new migrations — otherwise the template
  # drifts behind HEAD and Django applies deltas against the cloned test DB.
  local action="${1:-}"
  case "$action" in
    refresh|check) ;;
    "" )           err "usage: wt template <refresh|check>" ;;
    *)             err "unknown template action: $action (try: refresh, check)" ;;
  esac

  local main_env="${PROJECT_ROOT}/.env"
  [[ -f "$main_env" ]] || err "missing $main_env"
  local main_db main_user main_pw main_port main_host tmpl
  main_db="$(read_env_var DB_NAME     "$main_env")"
  main_user="$(read_env_var DB_USER   "$main_env")"
  main_pw="$(read_env_var DB_PASSWORD "$main_env")"
  main_port="$(read_env_var DB_PORT   "$main_env")"
  main_host="$(read_env_var DB_HOST   "$main_env")"; main_host="${main_host:-127.0.0.1}"
  [[ -n "$main_db" ]] || err "DB_NAME not set in $main_env"
  tmpl="$(template_db_name)"
  local pg_args=(-h "$main_host" -p "$main_port" -U "$main_user")

  if [[ "$action" == "check" ]]; then
    if template_db_exists; then
      log "template DB present: $tmpl"
      log "(refresh after migrations land on ${BASE_BRANCH} so the clone stays in sync)"
    else
      log "no template DB. Run: bin/wt template refresh"
    fi
    return 0
  fi

  log "drop database $tmpl (if exists)"
  PGPASSWORD="$main_pw" dropdb "${pg_args[@]}" --if-exists --force "$tmpl"

  log "createdb $tmpl"
  PGPASSWORD="$main_pw" createdb "${pg_args[@]}" "$tmpl"

  # Apply the full migration set to the template. Run the *main repo's* venv against
  # the template DB by overriding DB_NAME at process scope — python-decouple checks
  # os.environ before the .env file, so the override wins for this one command.
  local py="${PROJECT_ROOT}/.venv/bin/python"
  [[ -x "$py" ]] || err "main .venv not found at $py — run 'uv sync' there first"

  log "manage.py migrate against $tmpl (this is the slow part)"
  ( cd "$PROJECT_ROOT" && DB_NAME="$tmpl" "$py" manage.py migrate --noinput )

  log "template DB ready: $tmpl"
  log "next 'manage.py test' in worktrees clones it (fast test-DB build)"
  log "remember to refresh after migrations land on ${BASE_BRANCH}"
}

case "${1:-}" in
  new)               shift; cmd_new      "$@" ;;
  rm)                shift; cmd_rm       "$@" ;;
  sync)              shift; cmd_sync     "$@" ;;
  prune)             shift; cmd_prune    "$@" ;;
  template)          shift; cmd_template "$@" ;;
  ls)                git -C "$PROJECT_ROOT" worktree list ;;
  -h|--help|help|"") sed -n '2,13p' "$0" | sed 's/^# \?//' ;;
  *)                 err "unknown subcommand: $1 (try: wt help)" ;;
esac
